{
  "name": "dsh-comfy-cards-next",
  "displayName": "Comfy Cards Next",
  "version": "0.8.0",
  "description": "Comfy Cards Next — ComfyUI drawing console for DSH (Anima / LLLite / role & style cards)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/app.js",
    "lib/dict.js",
    "lib/presets.js",
    "lib/workflow.js",
    "lib/dictcard.js",
    "lib/online_models.js",
    "lib/randomlib.js",
    "tools/build_client.mjs",
    "lib/client.js",
    "lib/index.js",
    "py/expander.py",
    "py/sidecar_auth.py",
    "py/sidecar_cards.py",
    "py/sidecar_comfy.py",
    "py/sidecar_config.py",
    "py/sidecar_dirs.py",
    "py/sidecar_llm.py",
    "py/sidecar_loras.py",
    "py/sidecar_pack.py",
    "py/sidecar_routes.py",
    "py/sidecar_state.py",
    "py/sidecar_util.py",
    "py/sidecar_aline.py",
    "aline_mods/comfy_install.py",
    "aline_mods/comfy_paths.py",
    "aline_mods/compatibility.py",
    "aline_mods/cross_paths.py",
    "aline_mods/face_models.py",
    "aline_mods/install_post_controls.py",
    "aline_mods/install_translation.py",
    "aline_mods/launch_modes.py",
    "aline_mods/model_assets.py",
    "aline_mods/offline_translation.py",
    "aline_mods/online_models.py",
    "aline_mods/post_processing.py",
    "aline_mods/runtime_bridge.py",
    "aline_mods/tag_dictionary.py",
    "dictionary_seed.json",
    "py/install_post_controls.py",
    "py/install_translation.py",
    "py/face_models.py",
    "comfy_nodes/",
    "config.example.json",
    "cordis.patch.yml",
    "routes.json",
    "README.md",
    "CHANGELOG.md",
    "install.ps1",
    "docs/",
    "tools/cleanup.py",
    "tools/uninstall.ps1",
    "tools/cleanup-monthly.cmd",
    "tools/build_client.py",
    "tools/update.ps1",
    "tools/build_suite.py",
    "tools/annotate_card.py",
    "tools/check_naming.py",
    "tools/check_tdz.py",
    "py/sidecar_selfupdate.py"
  ],
  "scripts": {
    "build:client": "node tools/build_client.mjs",
    "check:client": "node tools/build_client.mjs --check",
    "build:client:py": "python tools/build_client.py",
    "preuninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/uninstall.ps1 -Auto"
  },
  "keywords": [
    "dsh",
    "cordis",
    "comfyui",
    "lora",
    "anima",
    "lllite",
    "image-generation"
  ],
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "configVersion": 2,
    "minHost": "0.2.0-rc.2",
    "update": {
      "inPlace": [
        "lib/client.js",
        "lib/index.js",
        "py/expander.py",
        "py/sidecar_auth.py",
        "py/sidecar_cards.py",
        "py/sidecar_comfy.py",
        "py/sidecar_config.py",
        "py/sidecar_llm.py",
        "py/sidecar_pack.py",
        "py/sidecar_routes.py",
        "py/sidecar_state.py",
        "py/sidecar_util.py",
        "routes.json",
        "lora来源.json",
        "py/sidecar_dirs.py",
        "py/sidecar_loras.py",
        "py/sidecar_aline.py",
        "aline_mods/",
        "dictionary_seed.json",
        "py/install_post_controls.py",
        "py/install_translation.py",
        "py/face_models.py",
        "comfy_nodes/",
        "tools/",
        "cordis.patch.yml"
      ],
      "preserve": [
        "config.json",
        "config.example.json",
        "workDir",
        "cardsDir",
        "outputDir"
      ],
      "restart": "dsh web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
