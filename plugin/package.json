{
  "name": "dsh-comfyui-console",
  "version": "0.7.152",
  "description": "ComfyUI drawing console for DSH (Anima / LLLite / role & style cards)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "expander.py",
    "sidecar_auth.py",
    "sidecar_cards.py",
    "sidecar_comfy.py",
    "sidecar_config.py",
    "sidecar_dirs.py",
    "sidecar_llm.py",
    "sidecar_loras.py",
    "sidecar_pack.py",
    "sidecar_routes.py",
    "sidecar_state.py",
    "sidecar_util.py",
    "sidecar_aline.py",
    "aline_mods/comfy_install.py",
    "aline_mods/comfy_paths.py",
    "aline_mods/compatibility.py",
    "aline_mods/cross_paths.py",
    "aline_mods/face_models.py",
    "aline_mods/install_post_controls.py",
    "aline_mods/install_translation.py",
    "aline_mods/launch_modes.py",
    "aline_mods/model_assets.py",
    "aline_mods/offline_translation.py",
    "aline_mods/online_models.py",
    "aline_mods/post_processing.py",
    "aline_mods/runtime_bridge.py",
    "aline_mods/tag_dictionary.py",
    "dictionary_seed.json",
    "install_post_controls.py",
    "install_translation.py",
    "face_models.py",
    "comfy_nodes/",
    "config.example.json",
    "cordis.patch.yml",
    "routes.json",
    "lora来源.json",
    "README.md",
    "CHANGELOG.md",
    "install.ps1",
    "docs/"
  ],
  "scripts": {
    "build:client": "node tools/build_client.mjs",
    "check:client": "node tools/build_client.mjs --check",
    "build:client:py": "python tools/build_client.py"
  },
  "keywords": [
    "dsh",
    "cordis",
    "comfyui",
    "lora",
    "anima",
    "lllite",
    "image-generation"
  ],
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "configVersion": 2,
    "minHost": "0.2.0-rc.2",
    "update": {
      "inPlace": [
        "lib/client.js",
        "lib/index.js",
        "expander.py",
        "sidecar_auth.py",
        "sidecar_cards.py",
        "sidecar_comfy.py",
        "sidecar_config.py",
        "sidecar_llm.py",
        "sidecar_pack.py",
        "sidecar_routes.py",
        "sidecar_state.py",
        "sidecar_util.py",
        "routes.json",
        "lora来源.json",
        "sidecar_dirs.py",
        "sidecar_loras.py",
        "sidecar_aline.py",
        "aline_mods/",
        "dictionary_seed.json",
        "install_post_controls.py",
        "install_translation.py",
        "face_models.py",
        "comfy_nodes/"
      ],
      "preserve": [
        "config.json",
        "config.example.json",
        "workDir",
        "cardsDir",
        "outputDir"
      ],
      "restart": "dsh web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
